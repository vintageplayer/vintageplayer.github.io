---
import { projectGroups } from "@/data/catalog";
import Base from "@/layouts/Base.astro";
---

<Base meta={{ title: "Projects", description: "Things Aditya Agarwal is building, or built in the past." }}>
	<div class="catalog">
		<h1 class="catalog-intro">Some of the things I’m building, or built in the past.</h1>
		{
			projectGroups.map((group) => (
				<section class="catalog-group">
					<h2>{group.title}</h2>
					<ul class="project-list">
						{group.projects.map((project) => (
							<li>
								<p>
									{project.href ? (
										<a href={project.href} rel="noopener" target="_blank">
											{project.name}
										</a>
									) : (
										project.name
									)}{" "}
									<span class="catalog-meta">· {project.status}</span>
								</p>
								{project.line && <p class="catalog-line">{project.line}</p>}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</Base>
