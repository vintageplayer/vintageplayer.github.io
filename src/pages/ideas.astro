---
import { ideas } from "@/data/catalog";
import Base from "@/layouts/Base.astro";

const slug = (category: string) => `cat-${category.toLowerCase()}`;
const categories = [...new Set(ideas.map((idea) => idea.category))];
const count = (category: string) => ideas.filter((idea) => idea.category === category).length;
---

<Base meta={{ title: "Ideas", description: "Problems Aditya Agarwal would like to see solved." }}>
	<div class="catalog">
		<h1 class="catalog-intro">Problems I’d like to see solved, by me or anyone else.</h1>
		<nav aria-label="Categories" class="idea-filter">
			<a aria-current="true" data-filter="all" href="#ideas">All <span>{ideas.length}</span></a>
			{
				categories.map((category) => (
					<a data-filter={category} href={`#${slug(category)}`}>
						{category} <span>{count(category)}</span>
					</a>
				))
			}
		</nav>
		<ol class="idea-list" id="ideas">
			{
				ideas.map((idea, index) => {
					const first = ideas[index - 1]?.category !== idea.category;
					return (
						<li class:list={[first && "is-first"]} data-category={idea.category}>
							<span class="idea-category" id={first ? slug(idea.category) : undefined}>
								{first ? idea.category : ""}
							</span>
							<span class="idea-number">{String(index + 1).padStart(2, "0")}</span>
							<span>{idea.text}</span>
						</li>
					);
				})
			}
		</ol>
	</div>
</Base>

<script>
	// Without JavaScript the category links jump to each group; with it they filter the list.
	const links = document.querySelectorAll<HTMLAnchorElement>(".idea-filter a");
	const rows = [...document.querySelectorAll<HTMLLIElement>(".idea-list li")];
	for (const link of links) {
		link.addEventListener("click", (event) => {
			event.preventDefault();
			const filter = link.dataset.filter;
			for (const other of links) {
				if (other === link) other.setAttribute("aria-current", "true");
				else other.removeAttribute("aria-current");
			}
			let firstShown = true;
			for (const row of rows) {
				const show = filter === "all" || row.dataset.category === filter;
				row.hidden = !show;
				row.classList.toggle("is-lead", show && firstShown);
				if (show) firstShown = false;
			}
		});
	}
	rows[0]?.classList.add("is-lead");
</script>
