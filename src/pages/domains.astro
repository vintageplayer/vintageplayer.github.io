---
import { domainGroups } from "@/data/catalog";
import Base from "@/layouts/Base.astro";
---

<Base meta={{ title: "Domains", description: "Domains Aditya Agarwal has bought, and the ideas behind them." }}>
	<div class="catalog">
		<h1 class="catalog-intro">
			Domains I’ve bought: ideas I was excited enough about to name. Most have nothing on them yet.
		</h1>
		{
			domainGroups.map((group) => (
				<section class="catalog-group">
					<h2>{group.title}</h2>
					<ul class="domain-list">
						{group.domains.map((domain) => (
							<li>
								<span class="domain-name">
									{domain.href ? (
										<a
											href={domain.href}
											rel={domain.href.startsWith("http") ? "noopener" : undefined}
											target={domain.href.startsWith("http") ? "_blank" : undefined}
										>
											{domain.name}
										</a>
									) : (
										domain.name
									)}
								</span>
								{domain.line && <span class="catalog-line">{domain.line}</span>}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</Base>
