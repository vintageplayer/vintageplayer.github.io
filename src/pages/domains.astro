---
import { domainGroups } from "@/data/catalog";
import Base from "@/layouts/Base.astro";
---

<Base meta={{ title: "Domain names", description: "Domains Aditya Agarwal has bought, and the ideas behind them." }}>
	<div class="catalog">
		<h1 class="catalog-intro">
			Domains I’ve bought: ideas I got myself hyped enough to name.
		</h1>
		{
			domainGroups.map((group) => (
				<section class="catalog-group">
					<h2>{group.title}</h2>
					<ul class="domain-list">
						{group.domains.map((domain) => (
							<li>
								<span class="domain-name">
									{domain.href ? (
										<a
											href={domain.href}
											rel={domain.href.startsWith("http") ? "noopener" : undefined}
											target={domain.href.startsWith("http") ? "_blank" : undefined}
										>
											{domain.name}
										</a>
									) : (
										domain.name
									)}
								</span>
								{(domain.line || domain.status === "building") && (
									<span class="catalog-line">
										{domain.status === "building" && <span class="domain-building">building</span>}
										{domain.status === "retired" ? (
											<>
												<span class="visually-hidden">Retired: </span>
												<span class="is-retired">{domain.line}</span>
											</>
										) : (
											domain.line
										)}
										{domain.note && ` ${domain.note}`}
									</span>
								)}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</Base>
