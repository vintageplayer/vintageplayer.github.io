---
import { offWork } from "@/data/catalog";
import Base from "@/layouts/Base.astro";

const slug = (title: string) => `off-${title.toLowerCase().replaceAll(" ", "-")}`;
---

<Base meta={{ title: "Off work", description: "What Aditya Agarwal is up for outside work." }}>
	<div class="catalog">
		<h1 class="catalog-intro">
			Off work, I’d rather be doing something active, anything on this list or just time in Dolores Park, Golden
			Gate Park or the Presidio, than sitting inside eating or watching others play.
		</h1>
		<p class="catalog-line off-work-home"><span class="catalog-meta">At home</span>&nbsp; Vegetarian; I cook fresh, high-protein meals every day.</p>
		<nav aria-label="Sections" class="idea-filter">
			{
				offWork.map((group, index) => (
					<a aria-current={index === 0 ? "true" : undefined} data-tab={slug(group.title)} href={`#${slug(group.title)}`}>
						{group.title} <span>{group.items.length}</span>
					</a>
				))
			}
		</nav>
		{
			offWork.map((group) => (
				<section class="catalog-group off-work-group" id={slug(group.title)}>
					<h2>{group.title}</h2>
					<ul class="project-list off-work-list">
						{group.items.map((item) => (
							<li>
								<p>{item.text}</p>
								{item.note && <p class="catalog-line">{item.note}</p>}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</Base>

<script>
	// Without JavaScript every section shows and the links jump to it; with it they switch between sections.
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".idea-filter a[data-tab]")];
	const sections = [...document.querySelectorAll<HTMLElement>(".off-work-group")];
	const show = (id: string) => {
		for (const section of sections) section.hidden = section.id !== id;
		for (const link of links) {
			if (link.dataset.tab === id) link.setAttribute("aria-current", "true");
			else link.removeAttribute("aria-current");
		}
	};
	for (const link of links) {
		link.addEventListener("click", (event) => {
			event.preventDefault();
			show(link.dataset.tab ?? "");
		});
	}
	document.querySelector(".catalog")?.classList.add("is-tabbed");
	show(links[0]?.dataset.tab ?? "");
</script>
