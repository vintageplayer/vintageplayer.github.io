---
import Base from "@/layouts/Base.astro";
import { emailText, siteConfig, socialLinks } from "@/site.config";

const ledger = [
	{ span: "3 years", text: "building petabyte-scale data infrastructure" },
	{ span: "2 years", text: "building my own product,", link: { href: "https://jiffyscan.xyz/", title: "JiffyScan" } },
	{ span: "3 years", text: "selling developer tools with", link: { href: "https://devranker.com/", title: "DevRanker" } },
	{
		span: "Now",
		text: "building",
		link: { href: "https://devscan.ai/", title: "DevScan" },
		after: ", for agent-driven sales: selling to coding agents instead of developers",
	},
];
---

<Base bare meta={{ title: siteConfig.title }}>
	<div class="home">
		<header class="home-intro">
			<h1>{siteConfig.author}</h1>
			<p>I’ve spent eight years in data platforms and developer tools.</p>
		</header>
		<ol class="home-ledger">
			{
				ledger.map((row) => (
					<li class:list={[row.span === "Now" && "is-now"]}>
						<span>{row.span}</span>
						<span>
							{row.text}
							{row.link && (
								<>
									{" "}
									<a href={row.link.href}>{row.link.title}</a>
								</>
							)}
							{row.after}
						</span>
					</li>
				))
			}
		</ol>
		<footer class="home-contact">
			<nav aria-label="Elsewhere">
				{socialLinks.map((link) => <a href={link.href}>{link.title}</a>)}
			</nav>
			<p>{emailText}</p>
		</footer>
	</div>
</Base>
