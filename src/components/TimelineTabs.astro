---
import type { CollectionEntry } from "astro:content";

interface Props {
	entries: CollectionEntry<"timeline">[];
}

const { entries } = Astro.props;
const categories = [
	{
		id: "professional",
		label: "Professional",
	},
	{
		id: "before-graduation",
		label: "Before graduation",
	},
	{
		id: "life",
		label: "Life outside work",
	},
] as const;
---

<timeline-tabs class="timeline-tabs-block">
	<div class="tab-list" role="tablist" aria-label="Timeline view">
		{
			categories.map((category, index) => (
				<button
					aria-controls={`timeline-${category.id}`}
					aria-selected={index === 0 ? "true" : "false"}
					class:list={[index === 0 && "is-selected"]}
					data-tab={category.id}
					id={`tab-${category.id}`}
					role="tab"
					type="button"
				>
					{category.label}
				</button>
			))
		}
	</div>
	{
		categories.map((category, index) => {
			const categoryEntries = entries
				.filter((entry) => entry.data.category === category.id)
				.sort((a, b) => a.data.order - b.data.order);
			return (
				<section
					aria-labelledby={`tab-${category.id}`}
					data-panel={category.id}
					hidden={index !== 0}
					id={`timeline-${category.id}`}
					role="tabpanel"
				>
					<ol class="timeline-list">
						{categoryEntries.map((entry) => (
							<li>
								<time>{entry.data.period}</time>
								<h3>{entry.data.title}</h3>
							</li>
						))}
					</ol>
				</section>
			);
		})
	}
</timeline-tabs>

<script>
	class TimelineTabs extends HTMLElement {
		connectedCallback() {
			const tabs = this.querySelectorAll<HTMLButtonElement>("[data-tab]");
			const panels = this.querySelectorAll<HTMLElement>("[data-panel]");

			for (const tab of tabs) {
				tab.addEventListener("click", () => {
					const selectedView = tab.dataset.tab;
					for (const candidate of tabs) {
						const selected = candidate === tab;
						candidate.classList.toggle("is-selected", selected);
						candidate.setAttribute("aria-selected", String(selected));
					}
					for (const panel of panels) panel.hidden = panel.dataset.panel !== selectedView;
				});
			}
		}
	}

	customElements.define("timeline-tabs", TimelineTabs);
</script>
