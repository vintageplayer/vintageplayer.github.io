---
import { menuLinks, siteConfig } from "@/site.config";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<a class="site-name" href="/">{siteConfig.title}</a>
	<nav aria-label="Primary">
		{
			menuLinks.map((link) => (
				<a aria-current={currentPath.startsWith(link.path) ? "page" : undefined} href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</header>
