---
import Base from "@/layouts/Base.astro";

interface Props {
	backHref: string;
	backLabel: string;
	description: string;
	meta: string[];
	title: string;
}

const { backHref, backLabel, description, meta, title } = Astro.props;
---

<Base meta={{ title, description }}>
	<article class="detail-page">
		<a class="back-link" href={backHref}>← {backLabel}</a>
		<header class="detail-heading">
			<p class="detail-meta">{meta.join(" · ")}</p>
			<h1>{title}</h1>
			<p class="editorial-lead">{description}</p>
		</header>
		<div class="prose"><slot /></div>
		<a class="end-link" href={backHref}>← {backLabel.replace("Back to ", "All ")}</a>
	</article>
</Base>
