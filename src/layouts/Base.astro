---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/** Leave out the site header and footer, for pages that carry their own. */
	bare?: boolean;
}

const { meta, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...meta} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class:list={["site-shell", bare && "is-bare"]}>
			{!bare && <Header />}
			<main id="main"><slot /></main>
			{!bare && <Footer />}
		</div>
	</body>
</html>
